# Copy to .cargo/secrets.toml (git-ignored) and fill in. Read at build time: the firmware stores
# the network in flash at its first boot, and uses the stored one afterwards (`factory-reset`
# on the console forgets it).
[env]
WIFI_SSID = "my-network"
WIFI_PASS = "my-password"
# Optional: the MQTT broker (`host` or `host:port`), also stored at the first boot. Or set it
# later with `mqtt HOST[:PORT] [USER PASS]` on the USB console.
# MQTT_HOST = "192.168.1.10"
# MQTT_USER = ""
# MQTT_PASS = ""
# Optional, with the `ha-update` feature: the manifest Home Assistant's updates come from, also
# stored at the first boot. Or `update-url URL` on the console.
# OTA_MANIFEST_URL = "http://192.168.1.10:8080/devkit/manifest.json"
# Optional, with Matter: one pairing code built in (the same on every device built with it,
# printable as a label; `cargo iotkit new` draws one). Without them, each device draws its own.
# MATTER_PASSCODE = "79771663"
# MATTER_DISCRIMINATOR = "985"
# Optional, with the `esphome-api` feature: the encryption key Home Assistant asks for (32 bytes
# in base64; `cargo iotkit new` draws one). Without it, each device makes its own (`api-key`).
# ESPHOME_API_KEY = "Q2hhbmdlIG1lOiAzMiBieXRlcyBpbiBiYXNlNjQhIQA="
