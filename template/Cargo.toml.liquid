[package]
name         = "{{project-name}}"
edition      = "2024"
rust-version = "1.95"
# The firmware version: bump it for each update (`cargo iotkit ota push` refuses downgrades).
version      = "0.1.0"
publish      = false

# Read by `cargo iotkit` (signed builds, flashing, OTA).
[package.metadata.iotkit]
chip       = "{{chip}}"
flash-size = "{% if chip == "esp32c3" %}4mb{% else %}8mb{% endif %}"

[features]
{% if chip == "esp32c6" %}## Matter over Wi-Fi, next to MQTT (needs the 8 MB partition table).
matter-wifi = ["iotkit/matter-wifi"]
{% endif %}
[dependencies]
# From GitHub. A local checkout instead: `iotkit_path` (cargo generate), `--iotkit-path` (cargo iotkit new).
{% if iotkit_path == "" %}iotkit = { git = "https://github.com/tanguy-c/iotkit", features = ["{{chip}}", "ha-update"] }{% else %}iotkit = { path = "{{iotkit_path}}/crates/iotkit", features = ["{{chip}}", "ha-update"] }{% endif %}

esp-hal                = { version = "~1.2.2", features = ["{{chip}}", "log-04", "unstable"] }
esp-rtos               = { version = "0.4.0", features = ["embassy", "esp-alloc", "esp-radio", "{{chip}}", "log-04"] }
esp-hal-smartled       = { version = "0.18", features = ["{{chip}}"] }
embassy-executor       = { version = "0.10.0", features = ["log"] }
embassy-futures        = "0.1"
embassy-time           = { version = "0.5.1", features = ["log"] }
smart-leds             = "0.4"
# Release builds keep info logs and up (debug and trace are compiled out); debug builds keep all.
log                    = { version = "0.4.27", features = ["release_max_level_info"] }

[build-dependencies]
{% if iotkit_path == "" %}iotkit-build = { git = "https://github.com/tanguy-c/iotkit" }{% else %}iotkit-build = { path = "{{iotkit_path}}/crates/iotkit-build" }{% endif %}

# A standalone project, even when generated inside another workspace.
[workspace]

[profile.dev]
# The default debug profile is too slow and too big for the chip.
opt-level = "s"

[profile.release]
codegen-units = 1
debug         = 2
lto           = 'fat'
opt-level     = 's'

# Ed25519 verification (updates) unrolls into about 1.2 MB at `s`; at `z` it is a fraction of
# that. Also for `iotkit-image`, as LTO inlines the verification into it.
[profile.release.package.ed25519-compact]
opt-level = "z"

[profile.dev.package.ed25519-compact]
opt-level = "z"

[profile.release.package.iotkit-image]
opt-level = "z"
