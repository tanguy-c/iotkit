{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flash USB",
      "detail": "Build, flash over USB and open the serial monitor",
      "type": "shell",
      "command": "cargo run --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Monitor",
      "type": "shell",
      "command": "espflash monitor --chip {{chip}}",
      "problemMatcher": []
    },
    {
      "label": "Build signed",
      "detail": "Release build, app image and signed manifest in dist/",
      "type": "shell",
      "command": "cargo iotkit build --release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "OTA push",
      "detail": "Build, sign, and have the device install it",
      "type": "shell",
      "command": "cargo iotkit ota push --release --host ${input:otaHost}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Build debug",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    }
  ],
  "inputs": [
    { "id": "otaHost", "type": "promptString", "description": "Device host name", "default": "iotkit-XXXX.local" }
  ]
}
